rules_version = '2';

// Firebase está CERRADO desde el 3 de octubre de 2026.
//
// La base del equipo es Supabase (ver supabase/LEEME.md). Lo que quedó en
// Firestore es una copia vieja, y la última copia de seguridad de Firebase
// está bajada aparte. Estas reglas no dejan leer ni escribir nada, a nadie:
// así una pestaña vieja abierta no puede seguir cargando en una base que ya
// no usa nadie, y quien tuvo acceso alguna vez no puede seguir leyendo esa
// copia.
//
// Las reglas anteriores, completas, quedaron en el historial del repo (y en
// la rama firebase-v1).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
