rules_version = '2';

// Reglas de Firestore para "Registro de Acciones — Team LatAm".
//
// Acceso privado: solo entra quien inició sesión con Google Y está en la
// lista de aprobados ("allowlist"), o es el admin fijo (ver ADMIN_EMAIL
// abajo). Nadie más puede leer ni escribir nada, ni con la URL de la
// página ni con el projectId/apiKey (que no son secretos, pero ya no
// alcanzan por sí solos).
//
// Flujo: alguien inicia sesión con Google → si su email no está en
// "allowlist", la app crea un documento en "accessRequests" → el admin
// entra al panel "Solicitudes" de la propia app y aprueba o rechaza →
// aprobar escribe un documento en "allowlist" → recién ahí esa persona
// puede leer y escribir posts/replies.
//
// IMPORTANTE (encontrado con mucho debugging): NUNCA combinar isAdmin()
// con isApproved() (que usa exists()) dentro de una misma expresión con
// "||" o "?:" — el motor de reglas terminaba rechazando TODO, incluso
// para el admin, cuando se combinaban así. La solución que sí funciona
// de forma confiable es declarar líneas "allow" SEPARADAS para cada
// caso: Firestore las combina como "o" de todos modos, sin ese problema.
//
// Las respuestas ("replies") se leen posteo por posteo (subcolección
// normal), NUNCA con una consulta collectionGroup: se detectó que esas
// consultas devuelven "Missing or insufficient permissions" en este
// proyecto sin importar la regla (se probó hasta con "if true" y seguía
// fallando) — no se identificó la causa exacta, así que del lado de la
// app se evita ese tipo de consulta en vez de seguir insistiendo acá.

service cloud.firestore {
  match /databases/{database}/documents {

    // Único email con permisos de administrador. Tiene que coincidir
    // exactamente con ADMIN_EMAIL en index.html — si se cambia uno hay
    // que cambiar el otro y volver a publicar estas reglas.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "benny@team-latam.com";
    }
    function isApproved() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email));
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }
    function isOptionalString(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    // Los campos individuales de cada scope/link no se validan en profundidad
    // aquí (el lenguaje de reglas no itera listas de mapas cómodamente): se
    // limitan tamaños de lista y de strings, que es lo que evita abuso real
    // (documentos gigantes, spam). La forma fina de cada scope la valida el
    // cliente antes de escribir.
    // OJO: usar SIEMPRE d.get('campo', null) para cualquier campo que pueda
    // no existir en el documento (en vez de d.campo directo). Acceder con
    // "." a una clave ausente hace que el motor de reglas tire un error de
    // evaluación (no un simple "null"), y eso rechaza el request entero con
    // el mismo "Missing or insufficient permissions" aunque el usuario y el
    // resto de las condiciones estén bien. campos como cancelled,
    // calendarEventId, lastEditedBy y lastEditedAt no se guardan al crear
    // un posteo (recién aparecen en la primera edición/cancelación), así
    // que con acceso directo esto rompía todas las ediciones.
    function isValidPostBase(d) {
      return isNonEmptyString(d.title, 140) &&
        isNonEmptyString(d.content, 5000) &&
        isNonEmptyString(d.date, 10) &&
        isNonEmptyString(d.startDate, 10) &&
        isNonEmptyString(d.endDate, 10) &&
        isOptionalString(d.get('organizer', null), 140) &&
        isOptionalString(d.get('location', null), 200) &&
        d.activityType in ['rutina', 'visita', 'curso', 'seminario', 'congreso', 'otro'] &&
        isNonEmptyString(d.authorName, 120) &&
        isOptionalString(d.get('authorEmail', null), 200) &&
        d.scopes is list && d.scopes.size() >= 0 && d.scopes.size() <= 15 &&
        (d.get('links', null) == null || (d.links is list && d.links.size() <= 10)) &&
        (d.get('images', null) == null || (d.images is list && d.images.size() <= 6)) &&
        (d.get('cancelled', null) == null || d.cancelled is bool) &&
        isOptionalString(d.get('calendarEventId', null), 200) &&
        isOptionalString(d.get('lastEditedBy', null), 120) &&
        (d.get('lastEditedAt', null) == null || d.lastEditedAt is timestamp);
    }

    // Quién puede editar un posteo YA EXISTENTE (se evalúa sobre
    // resource.data, el estado ANTES del cambio, nunca sobre lo que
    // alguien intenta escribir): el propio autor siempre puede, y
    // cualquier persona aprobada puede editar los que no son Rutina
    // (son eventos compartidos del equipo, no una entrada personal).
    function isAuthorOrNonRoutine(existing) {
      return existing.authorEmail == request.auth.token.email || existing.activityType != 'rutina';
    }

    function isValidPostUpdate(d) {
      return isValidPostBase(d) &&
        d.scopes.size() >= 1 &&
        d.authorEmail == resource.data.authorEmail &&
        d.authorName == resource.data.authorName &&
        d.createdAt == resource.data.createdAt;
    }

    function isValidReplyCreate(d) {
      return isNonEmptyString(d.content, 3000) &&
        isNonEmptyString(d.authorName, 120) &&
        (d.get('scopes', null) == null || (d.scopes is list && d.scopes.size() <= 15)) &&
        (d.get('links', null) == null || (d.links is list && d.links.size() <= 10)) &&
        (d.get('images', null) == null || (d.images is list && d.images.size() <= 6)) &&
        (d.get('system', null) == null || d.system is bool) &&
        isOptionalString(d.get('icon', null), 8) &&
        d.createdAt == request.time;
    }

    match /posts/{postId} {
      allow read: if isAdmin();
      allow read: if isApproved();

      // El alcance mínimo de 1 lo exige el formulario del lado del
      // cliente, no esta regla: un posteo importado automáticamente desde
      // Google Calendar puede crearse sin alcance ("sin definir") para no
      // ensuciar los conteos de Países/Mapa hasta que alguien lo edite.
      allow create: if isAdmin() && isValidPostBase(request.resource.data) &&
        request.resource.data.createdAt == request.time;
      allow create: if isApproved() && isValidPostBase(request.resource.data) &&
        request.resource.data.createdAt == request.time;

      // Edición: no se puede tocar de quién es ni cuándo se creó
      // originalmente — solo el contenido puede cambiar.
      allow update: if isAdmin() && isAuthorOrNonRoutine(resource.data) && isValidPostUpdate(request.resource.data);
      allow update: if isApproved() && isAuthorOrNonRoutine(resource.data) && isValidPostUpdate(request.resource.data);

      allow delete: if false;

      match /replies/{replyId} {
        allow read: if isAdmin();
        allow read: if isApproved();

        allow create: if isAdmin() && isValidReplyCreate(request.resource.data);
        allow create: if isApproved() && isValidReplyCreate(request.resource.data);

        allow update, delete: if false;
      }
    }

    // Lista de emails aprobados. El documento existe = tiene acceso; el
    // contenido del documento no importa. Solo el admin la modifica; cada
    // usuario puede leer únicamente su propio documento (para saber si ya
    // fue aprobado).
    match /allowlist/{email} {
      allow get: if isAdmin();
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Solicitudes de acceso: cualquiera logueado puede crear/leer/reintentar
    // LA SUYA; el admin ve y decide todas.
    match /accessRequests/{email} {
      allow get: if isAdmin();
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.token.email == email &&
        request.resource.data.email == email && request.resource.data.status == 'pending';
      // El dueño puede "pedir de nuevo" (volver a poner su propia solicitud
      // en pending); solo el admin puede aprobar o rechazar.
      allow update: if isAdmin();
      allow update: if request.auth != null && request.auth.token.email == email &&
        request.resource.data.email == email && request.resource.data.status == 'pending';
      allow delete: if isAdmin();
    }

    // Estado interno de la sincronización Calendar → app (el "sync token"
    // de Google Calendar y cuándo se corrió la última vez). No es un dato
    // sensible, solo hace falta que quede fuera del alcance de cualquiera
    // no aprobado, igual que todo lo demás.
    function isValidSyncMeta(d) {
      return isOptionalString(d.get('syncToken', null), 2000) &&
        (d.get('lastSyncedAt', null) == null || d.lastSyncedAt is timestamp);
    }
    match /meta/{docId} {
      allow read: if isAdmin();
      allow read: if isApproved();
      allow write: if isAdmin() && isValidSyncMeta(request.resource.data);
      allow write: if isApproved() && isValidSyncMeta(request.resource.data);
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
