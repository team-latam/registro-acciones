rules_version = '2';

// Reglas de Firestore para "Registro de Acciones — Team LatAm".
//
// Acceso privado: solo entra quien inició sesión con Google Y está en la
// lista de aprobados ("allowlist"), o es el admin fijo (ver ADMIN_EMAIL
// abajo). Nadie más puede leer ni escribir nada, ni con la URL de la
// página ni con el projectId/apiKey (que no son secretos, pero ya no
// alcanzan por sí solos).
//
// Flujo: alguien inicia sesión con Google → si su email no está en
// "allowlist", la app crea un documento en "accessRequests" → el admin
// entra al panel "Solicitudes" de la propia app y aprueba o rechaza →
// aprobar escribe un documento en "allowlist" → recién ahí esa persona
// puede leer y escribir posts/replies.
//
// IMPORTANTE (encontrado con mucho debugging): NUNCA combinar isAdmin()
// con isApproved() (que usa exists()) dentro de una misma expresión con
// "||" o "?:" — el motor de reglas terminaba rechazando TODO, incluso
// para el admin, cuando se combinaban así. La solución que sí funciona
// de forma confiable es declarar líneas "allow" SEPARADAS para cada
// caso: Firestore las combina como "o" de todos modos, sin ese problema.
//
// Las respuestas ("replies") se leen con UNA consulta collectionGroup
// para todos los posteos (ver subscribeRepliesGroup en index.html) — con
// N listeners, uno por posteo, la cantidad crecía sin tope. Una consulta
// collectionGroup NO la cubre la regla anidada en /posts/{postId}/replies:
// necesita su propio `match /{path=**}/replies/{replyId}` (abajo). Eso es
// lo que faltaba cuando "hasta con `if true` seguía fallando" — el `if
// true` estaba en el match anidado, que no aplica a collection groups.
// La app conserva el modo posteo por posteo como respaldo automático si
// esta regla no está publicada todavía (permission-denied → fallback).

service cloud.firestore {
  match /databases/{database}/documents {

    // Único email con permisos de administrador. Tiene que coincidir
    // exactamente con ADMIN_EMAIL en index.html — si se cambia uno hay
    // que cambiar el otro y volver a publicar estas reglas.
    // TODO el modelo descansa en request.auth.token.email. Con solo
    // `request.auth != null`, cualquier proveedor de login habilitado en
    // el proyecto que deje elegir el email sin verificarlo (Email/Password,
    // por ejemplo) alcanzaría para presentarse como el admin o como
    // cualquier aprobado. La app solo usa Google, así que se exige eso
    // mismo acá: email verificado Y proveedor google.com. Se lee con
    // get() por la regla de oro de este archivo (una clave ausente con
    // "." tira error de evaluación y rechaza todo).
    function signedIn() {
      return request.auth != null &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com';
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "benny@team-latam.com";
    }
    function isApproved() {
      return signedIn() &&
        exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email));
    }
    // El propio email del token — para atar la autoría de lo que se escribe.
    function isSelf(email) {
      return signedIn() && request.auth.token.email == email;
    }
    function isValidDateStr(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }
    function isOptionalString(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    // Cambio de @nickname por la propia persona (ver renderUserBadge /
    // "Editar tu @nickname" en index.html): solo puede tocar el campo
    // nickname de SU PROPIO documento, y solo con un valor con forma de
    // nickname (letras/números ASCII en minúscula/guion bajo, sin
    // espacios ni "@", 2 a 20 caracteres) — nunca puede tocar name/
    // approvedAt/approvedBy/calendarShared/etc. Solo minúsculas a
    // propósito (las menciones @nickname siempre se muestran en
    // minúscula, ver highlightMentions/firstWordFrom en index.html): el
    // cliente ya manda todo en minúscula antes de escribir, así que
    // alcanza con RECHAZAR mayúsculas acá — no hace falta que el lenguaje
    // de reglas sepa bajar a minúscula (no lo hace de forma confiable).
    // Se restringe a ASCII a propósito (nada de \p{L}/acentos) aunque el
    // nickname AUTOGENERADO en el alta sí puede tener tildes/ñ: se probó
    // con el emulador y las clases Unicode acá tiraban error de
    // evaluación en varios casos (denegaba igual, pero por el motivo
    // equivocado) — mejor evitar esa incertidumbre en producción.
    // Unicidad y la palabra reservada "all" (usada para @all) se
    // controlan del lado del cliente antes de escribir, porque el
    // lenguaje de reglas no compara bien contra el resto de la colección.
    function isValidNicknameEdit(d) {
      return d.diff(resource.data).affectedKeys().hasOnly(['nickname']) &&
        d.nickname is string && d.nickname.matches('^[a-z0-9_]{2,20}$');
    }

    // Mismo patrón acotado que el nickname, para que cada persona pueda
    // anotar que ya vio el tutorial de bienvenida: SOLO el campo
    // tourSeenAt de su propio documento, y solo con la hora del servidor
    // (request.time es lo que vale un serverTimestamp()), así nadie se
    // inventa una fecha ni aprovecha la puerta para tocar otra cosa.
    // d.get(...) en vez de d.tourSeenAt por la regla de oro de este
    // archivo: el campo puede no existir (nadie lo tiene hasta que cierra
    // el tutorial) y el acceso con punto a una clave ausente tira error
    // de evaluación, que rechaza el request entero.
    // (Nota para quien pruebe con el emulador: al denegar un update por
    // hasOnly, el emulador SIEMPRE imprime "evaluation error" en el
    // detalle del rechazo, con punto o con get, y hasta con valores
    // literales. Es cómo reporta la denegación, no un problema de esta
    // función — se verificó caso por caso.)
    function isValidTourSeenEdit(d) {
      return d.diff(resource.data).affectedKeys().hasOnly(['tourSeenAt']) &&
        d.get('tourSeenAt', null) == request.time;
    }

    // Los campos individuales de cada scope/link no se validan en profundidad
    // aquí (el lenguaje de reglas no itera listas de mapas cómodamente): se
    // limitan tamaños de lista y de strings, que es lo que evita abuso real
    // (documentos gigantes, spam). La forma fina de cada scope la valida el
    // cliente antes de escribir.
    // OJO: usar SIEMPRE d.get('campo', null) para cualquier campo que pueda
    // no existir en el documento (en vez de d.campo directo). Acceder con
    // "." a una clave ausente hace que el motor de reglas tire un error de
    // evaluación (no un simple "null"), y eso rechaza el request entero con
    // el mismo "Missing or insufficient permissions" aunque el usuario y el
    // resto de las condiciones estén bien. campos como cancelled,
    // calendarEventId, lastEditedBy y lastEditedAt no se guardan al crear
    // un posteo (recién aparecen en la primera edición/cancelación), así
    // que con acceso directo esto rompía todas las ediciones.
    function isValidPostBase(d) {
      return isNonEmptyString(d.title, 140) &&
        isNonEmptyString(d.content, 5000) &&
        isValidDateStr(d.date) &&
        isValidDateStr(d.startDate) &&
        isValidDateStr(d.endDate) &&
        isOptionalString(d.get('organizer', null), 140) &&
        // Participantes taggeados (reemplaza a 'organizer' de a poco, ver
        // renderParticipantsField en index.html): lista de {email, name}.
        // Los campos internos de cada uno no se validan en profundidad acá
        // (mismo motivo que 'scopes'/'mentions'), solo el tamaño de la lista.
        (d.get('participants', null) == null || (d.participants is list && d.participants.size() <= 10)) &&
        isOptionalString(d.get('location', null), 200) &&
        // Hora de inicio/fin (HH:MM, opcional): un evento sin hora es
        // "todo el día" (ver allDay en index.html) — el mínimo/máximo de
        // que la de fin sea posterior a la de inicio lo valida el cliente,
        // acá solo se chequea el formato para no guardar cualquier cosa.
        (d.get('startTime', null) == null || (d.startTime is string && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&
        (d.get('endTime', null) == null || (d.endTime is string && d.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&
        // Los tipos NO son una lista fija: el admin agrega/renombra desde
        // Configuración > Tipos (slugifyKey en index.html → [a-z0-9]). Con
        // la lista de fábrica hardcodeada acá, el primer posteo con un tipo
        // nuevo fallaba con "Missing or insufficient permissions".
        d.activityType is string && d.activityType.matches('^[a-z0-9]{1,40}$') &&
        isNonEmptyString(d.authorName, 120) &&
        isOptionalString(d.get('authorEmail', null), 200) &&
        d.scopes is list && d.scopes.size() >= 0 && d.scopes.size() <= 15 &&
        (d.get('links', null) == null || (d.links is list && d.links.size() <= 10)) &&
        (d.get('images', null) == null || (d.images is list && d.images.size() <= 6)) &&
        // Adjuntos chicos (PDF/audio) embebidos como antes las imágenes,
        // sin pasar por Firebase Storage: como no se comprimen, se limita
        // la cantidad acá (el tamaño en bytes lo limita el cliente antes
        // de subir, ver MAX_ATTACHMENT_FILE_BYTES en index.html).
        (d.get('files', null) == null || (d.files is list && d.files.size() <= 2)) &&
        // @menciones: emails de a quién se etiquetó con @ en el texto.
        (d.get('mentions', null) == null || (d.mentions is list && d.mentions.size() <= 10)) &&
        (d.get('cancelled', null) == null || d.cancelled is bool) &&
        isOptionalString(d.get('calendarEventId', null), 200) &&
        isOptionalString(d.get('lastEditedBy', null), 120) &&
        (d.get('lastEditedAt', null) == null || d.lastEditedAt is timestamp);
    }

    // Quién puede editar un posteo YA EXISTENTE (se evalúa sobre
    // resource.data, el estado ANTES del cambio, nunca sobre lo que
    // alguien intenta escribir): el propio autor siempre puede, y
    // cualquier persona aprobada puede editar los que no son Rutina
    // (son eventos compartidos del equipo, no una entrada personal).
    // get() y no ".": authorEmail es opcional al crear (y puede faltar en
    // posteos viejos) — con acceso directo, un posteo sin ese campo
    // quedaba imposible de editar Y de likear para todo el mundo.
    function isAuthorOrNonRoutine(existing) {
      return existing.get('authorEmail', '') == request.auth.token.email || existing.get('activityType', '') != 'rutina';
    }

    // Quién firma un posteo nuevo: el propio token, o la forma exacta con
    // que la app importa un evento creado directo en Google Calendar
    // (authorName "Google Calendar", sin email, con calendarEventId).
    // Esa segunda forma sigue siendo forjable por un aprobado — sin
    // backend no hay manera de distinguirla — pero ya no se puede firmar
    // como OTRA persona real.
    function isPostAuthorOk(d) {
      return d.get('authorEmail', null) == request.auth.token.email ||
        (d.authorName == 'Google Calendar' && d.get('authorEmail', null) == '' && d.get('calendarEventId', null) is string);
    }
    // Claves permitidas al CREAR (la forma completa que arma el composer,
    // la rutina o la importación desde Calendar). Al editar se controla
    // con affectedKeys (más abajo) y no sobre el doc entero, para no
    // trabar la edición de posteos viejos con algún campo que ya no se use.
    function hasOnlyPostKeys(d) {
      return d.keys().hasOnly(['title', 'content', 'date', 'startDate', 'endDate', 'startTime', 'endTime',
        'organizer', 'participants', 'location', 'activityType', 'authorName', 'authorEmail',
        'scopes', 'links', 'images', 'files', 'mentions', 'calendarEventId', 'createdAt']);
    }
    function isValidPostCreate(d) {
      return isValidPostBase(d) && hasOnlyPostKeys(d) && isPostAuthorOk(d) && d.createdAt == request.time;
    }

    function isValidPostUpdate(d) {
      return isValidPostBase(d) &&
        // Solo pueden cambiar los campos de contenido: nunca de quién es,
        // cuándo se creó, ni likedBy (eso va por isValidLikeToggle).
        d.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'date', 'startDate', 'endDate',
          'startTime', 'endTime', 'organizer', 'participants', 'location', 'activityType', 'scopes',
          'links', 'images', 'files', 'mentions', 'cancelled', 'calendarEventId', 'lastEditedAt', 'lastEditedBy']) &&
        // El alcance mínimo de 1 solo se exige para Evento — Rutina es una
        // entrada rápida del día a día donde el lugar es opcional (se
        // agrega con el buscador de lugar del composer, si se quiere).
        // La tercera opción es para los posteos importados desde Calendar,
        // que nacen sin alcance ("sin definir"): cancelarlos o que Calendar
        // les cambie la fecha no toca `scopes`, y eso tiene que poder
        // guardarse — si no, el sync se trababa en ese evento para siempre.
        (d.activityType == 'rutina' || d.scopes.size() >= 1 || d.scopes == resource.data.get('scopes', [])) &&
        d.get('authorEmail', null) == resource.data.get('authorEmail', null) &&
        d.get('authorName', null) == resource.data.get('authorName', null) &&
        d.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    // Respuestas: la firma es el propio token, salvo los mensajes de
    // sistema que escribe la sincronización con Calendar (authorName
    // "Google Calendar", sin email). Los mensajes de sistema que disparan
    // las personas (✏️ editó, 🚫 canceló) sí llevan su propio email.
    function isReplyAuthorOk(d) {
      return d.get('authorEmail', null) == request.auth.token.email ||
        (d.get('system', null) == true && d.authorName == 'Google Calendar' && d.get('authorEmail', null) == null);
    }
    function isValidReplyCreate(d) {
      return isNonEmptyString(d.content, 3000) &&
        isNonEmptyString(d.authorName, 120) &&
        isOptionalString(d.get('authorEmail', null), 200) &&
        isReplyAuthorOk(d) &&
        d.keys().hasOnly(['content', 'authorName', 'authorEmail', 'scopes', 'images', 'links', 'files',
          'mentions', 'replyToId', 'system', 'icon', 'createdAt']) &&
        (d.get('scopes', null) == null || (d.scopes is list && d.scopes.size() <= 15)) &&
        (d.get('links', null) == null || (d.links is list && d.links.size() <= 10)) &&
        (d.get('images', null) == null || (d.images is list && d.images.size() <= 6)) &&
        (d.get('files', null) == null || (d.files is list && d.files.size() <= 2)) &&
        (d.get('mentions', null) == null || (d.mentions is list && d.mentions.size() <= 10)) &&
        (d.get('system', null) == null || d.system is bool) &&
        isOptionalString(d.get('icon', null), 8) &&
        isOptionalString(d.get('replyToId', null), 200) &&
        d.createdAt == request.time;
    }

    // "Me gusta" en una respuesta: la única edición permitida sobre una
    // respuesta ya creada. d es el documento COMPLETO después del cambio
    // (request.resource.data); solo puede tocar el campo likedBy, y nada
    // más que agregar o sacar el propio email de quien hace el pedido —
    // no se puede tocar el "me gusta" de otra persona ni ningún otro campo.
    // Se compara la lista ENTERA contra "la de antes + mi email" o "la de
    // antes sin mi email" (exactamente lo que producen arrayUnion y
    // arrayRemove en el cliente). Comparar solo el tamaño y la presencia
    // del propio email, como antes, dejaba pisar los likes de los demás:
    // [a,b,c] → [yo,x,y,z] pasaba (tamaño +1, yo adentro).
    function isValidLikeToggle(d) {
      let before = resource.data.get('likedBy', []);
      let email = request.auth.token.email;
      return d.diff(resource.data).affectedKeys().hasOnly(['likedBy']) &&
        d.likedBy is list && d.likedBy.size() <= 1000 &&
        (
          (!(email in before) && d.likedBy == before.concat([email])) ||
          (email in before && d.likedBy == before.removeAll([email]))
        );
    }

    match /posts/{postId} {
      allow read: if isAdmin();
      allow read: if isApproved();

      // El alcance mínimo de 1 lo exige el formulario del lado del
      // cliente, no esta regla: un posteo importado automáticamente desde
      // Google Calendar puede crearse sin alcance ("sin definir") para no
      // ensuciar los conteos de Países/Mapa hasta que alguien lo edite.
      // El id lo genera addDoc (20 caracteres alfanuméricos): un id con
      // comillas o < > es un doc escrito a mano, y viaja a data-post-id.
      allow create: if isAdmin() && postId.matches('^[A-Za-z0-9_-]{1,64}$') && isValidPostCreate(request.resource.data);
      allow create: if isApproved() && postId.matches('^[A-Za-z0-9_-]{1,64}$') && isValidPostCreate(request.resource.data);

      // Edición: no se puede tocar de quién es ni cuándo se creó
      // originalmente — solo el contenido puede cambiar.
      allow update: if isAdmin() && isAuthorOrNonRoutine(resource.data) && isValidPostUpdate(request.resource.data);
      allow update: if isApproved() && isAuthorOrNonRoutine(resource.data) && isValidPostUpdate(request.resource.data);

      // "Me gusta" en el posteo en sí (no solo en las respuestas): igual
      // que en replies, cualquier persona aprobada puede tocar SOLO su
      // propio email dentro de likedBy, sin importar quién sea el autor
      // ni si es Rutina o Evento.
      allow update: if isAdmin() && isValidLikeToggle(request.resource.data);
      allow update: if isApproved() && isValidLikeToggle(request.resource.data);

      allow delete: if false;

      match /replies/{replyId} {
        allow read: if isAdmin();
        allow read: if isApproved();

        allow create: if isAdmin() && replyId.matches('^[A-Za-z0-9_-]{1,64}$') && isValidReplyCreate(request.resource.data);
        allow create: if isApproved() && replyId.matches('^[A-Za-z0-9_-]{1,64}$') && isValidReplyCreate(request.resource.data);

        // Única edición permitida: dar/sacar tu propio "me gusta".
        allow update: if isAdmin() && isValidLikeToggle(request.resource.data);
        allow update: if isApproved() && isValidLikeToggle(request.resource.data);

        allow delete: if false;
      }
    }

    // Lectura de respuestas como collection group (todas las subcolecciones
    // "replies" de una vez). Solo lectura: crear/likear siguen yendo por
    // la ruta anidada de arriba, que es la que valida el contenido.
    match /{path=**}/replies/{replyId} {
      allow read: if isAdmin();
      allow read: if isApproved();
    }

    // Lista de aprobados: el documento existe = tiene acceso. Solo el admin
    // la modifica. Cualquier aprobado puede LEER LA LISTA COMPLETA (no solo
    // su propio documento) para poder etiquetar a otros con @ — el
    // documento de cada uno solo tiene email/name/nickname/approvedAt, no
    // datos sensibles.
    match /allowlist/{email} {
      allow get: if isAdmin();
      allow get: if isSelf(email);
      allow list: if isAdmin();
      allow list: if isApproved();
      allow write: if isAdmin();
      allow update: if isSelf(email) && isValidNicknameEdit(request.resource.data);
      allow update: if isSelf(email) && isValidTourSeenEdit(request.resource.data);
    }

    // Ex integrantes: quién estuvo en el equipo y ya no está. Se escribe al
    // revocar el acceso, ANTES de borrar su documento de allowlist, porque
    // el @nickname vive únicamente ahí: sin esta copia se pierde para
    // siempre y todos los posteos viejos de esa persona quedan con el
    // nombre crudo de Google, sin @nickname y sin perfil.
    //
    // Lo lee cualquier aprobado, igual que el roster y por el mismo motivo
    // (resolver el @nickname de quien escribió algo); lo escribe solo el
    // admin. No da acceso a nada: isApproved() sigue mirando únicamente si
    // existe el documento en allowlist.
    function isValidFormerMember(d) {
      return d.keys().hasOnly(['email', 'name', 'nickname', 'photoURL', 'approvedAt', 'revokedAt']) &&
        d.email is string && d.name is string &&
        d.nickname is string && d.nickname.matches('^[a-z0-9_]{0,20}$') &&
        (d.get('photoURL', null) == null || d.photoURL is string) &&
        d.revokedAt == request.time;
    }
    match /formerMembers/{email} {
      allow get: if isApproved();
      allow list: if isApproved();
      allow create: if isAdmin() && isValidFormerMember(request.resource.data);
      allow update: if isAdmin() && isValidFormerMember(request.resource.data);
      allow delete: if isAdmin();
    }

    // Preferencias personales (solapa "Configuración"): arranque de semana,
    // fines de semana, vista de N días, atenuar lo pasado, feriados y
    // notificaciones. Una colección aparte y NO un campo más de
    // allowlist/{email}, porque ese documento lo lee entero todo el equipo
    // (para las @menciones): acá cada uno lee y escribe SOLO el suyo, así
    // la configuración de cada persona no queda a la vista de los demás ni
    // viaja en cada snapshot del roster.
    //
    // Se validan las claves (hasOnly) y el tipo de cada una, con el mismo
    // criterio que el resto del archivo: no alcanza con que sea "su" doc,
    // porque si no cualquiera podría dejar ~1 MiB de campos arbitrarios en
    // su propio documento. Los valores fuera de rango no se validan uno por
    // uno a propósito (un customDays de 99 solo se rompe a sí mismo, y el
    // cliente ya lo acota al leerlo).
    function isValidUserPrefs(d) {
      return d.keys().hasOnly(['weekStart', 'showWeekends', 'customDays', 'dimPast',
          'holidayMode', 'holidayCountries', 'holidayJewish',
          'holidayColor', 'holidayJewishColor',
          'notifyTypes', 'notifyLead', 'notifyOnlyMine', 'notifyZones',
          'notifyReplies', 'calendarReminders']) &&
        (d.get('weekStart', 0) is int) &&
        (d.get('showWeekends', true) is bool) &&
        (d.get('customDays', 4) is int) &&
        (d.get('dimPast', false) is bool) &&
        (d.get('holidayMode', 'sutil') is string) &&
        (d.get('holidayCountries', []) is list) &&
        (d.get('holidayJewish', false) is bool) &&
        // Color en hex de 6 dígitos: es lo que escribe un <input type="color">.
        (d.get('holidayColor', '#000000') is string && d.holidayColor.matches('^#[0-9a-fA-F]{6}$')) &&
        (d.get('holidayJewishColor', '#000000') is string && d.holidayJewishColor.matches('^#[0-9a-fA-F]{6}$')) &&
        (d.get('notifyTypes', []) is list) &&
        (d.get('notifyLead', 0) is int) &&
        (d.get('notifyOnlyMine', false) is bool) &&
        (d.get('notifyZones', []) is list) &&
        (d.get('notifyReplies', true) is bool) &&
        (d.get('calendarReminders', false) is bool);
    }
    match /userPrefs/{email} {
      allow read: if isSelf(email);
      allow write: if isSelf(email) && isApproved() && isValidUserPrefs(request.resource.data);
    }

    // Solicitudes de acceso: cualquiera logueado puede crear/leer/reintentar
    // LA SUYA; el admin ve y decide todas. La forma es exactamente la que
    // escribe la app (ver requestAccessAgain / onAuthChanged en index.html):
    // sin eso, cualquier cuenta de Google podía dejar ~1 MiB de campos
    // arbitrarios en su propia solicitud, que después baja al panel del admin.
    function isValidAccessRequest(d, email) {
      return d.keys().hasOnly(['email', 'name', 'photoURL', 'status', 'requestedAt']) &&
        d.email == email && d.status == 'pending' &&
        isNonEmptyString(d.name, 120) &&
        isOptionalString(d.get('photoURL', null), 500) &&
        d.requestedAt == request.time;
    }
    match /accessRequests/{email} {
      allow get: if isAdmin();
      allow get: if isSelf(email);
      allow list: if isAdmin();
      allow create: if isSelf(email) && isValidAccessRequest(request.resource.data, email);
      // El dueño puede "pedir de nuevo" (volver a poner su propia solicitud
      // en pending); solo el admin puede aprobar o rechazar.
      allow update: if isAdmin();
      allow update: if isSelf(email) && isValidAccessRequest(request.resource.data, email);
      allow delete: if isAdmin();
    }

    // Estado interno de la sincronización Calendar → app (el "sync token"
    // de Google Calendar y cuándo se corrió la última vez). No es un dato
    // sensible, solo hace falta que quede fuera del alcance de cualquiera
    // no aprobado, igual que todo lo demás.
    function isValidSyncMeta(d) {
      return d.keys().hasOnly(['syncToken', 'lastSyncedAt']) &&
        isOptionalString(d.get('syncToken', null), 2000) &&
        d.get('lastSyncedAt', null) == request.time;
    }
    match /meta/calendarSync {
      allow read: if isAdmin();
      allow read: if isApproved();
      allow write: if isAdmin() && isValidSyncMeta(request.resource.data);
      allow write: if isApproved() && isValidSyncMeta(request.resource.data);
    }

    // Config de zonas/países del panel admin "Zonas" (ver
    // applyTerritoryConfig en index.html): a qué zona pertenece cada país
    // y el nombre/color de cada zona. Todos los aprobados lo LEEN (define
    // el color del mapa y los filtros de región para todo el mundo), pero
    // solo el admin lo puede escribir — reasignar un país de zona o
    // sumar una zona nueva es una decisión administrativa, no algo que
    // cualquiera deba poder tocar.
    function isValidTerritoryConfig(d) {
      return d.zones is map && d.countryZones is map;
    }
    match /meta/territoryConfig {
      allow read: if isAdmin();
      allow read: if isApproved();
      allow write: if isAdmin() && isValidTerritoryConfig(request.resource.data);
    }

    // Resto del panel admin "Preferencias" (Tipos de actividad, Lugares,
    // Calendar, Adjuntos — ver applyPreferencesConfig en index.html): un
    // solo doc con un campo por sección, cada sección se guarda con
    // merge así que esta validación corre sobre el documento COMPLETO
    // después del merge, no solo sobre lo que cambió. Todos los
    // aprobados lo LEEN (afecta a todo el mundo: tipos disponibles,
    // sugerencias de lugar, a qué Calendar se sincroniza, límites de
    // adjuntos), pero solo el admin lo escribe.
    function isValidPreferences(d) {
      return (d.get('activityTypes', null) == null || d.activityTypes is list) &&
        (d.get('extraCities', null) == null || d.extraCities is map) &&
        isOptionalString(d.get('calendarId', null), 200) &&
        (d.get('maxImages', null) == null || d.maxImages is int) &&
        (d.get('maxAttachmentFiles', null) == null || d.maxAttachmentFiles is int) &&
        // Tope duro de 500 KB por adjunto (mismo HARD_MAX_ATTACHMENT_FILE_BYTES
        // del cliente): sin techo, 2 adjuntos + 6 imágenes pasaban el
        // límite de 1 MiB por documento de Firestore y la escritura fallaba
        // con un error opaco después de esperar toda la codificación.
        (d.get('maxAttachmentFileBytes', null) == null || (d.maxAttachmentFileBytes is int && d.maxAttachmentFileBytes <= 512000));
    }
    match /meta/preferences {
      allow read: if isAdmin();
      allow read: if isApproved();
      allow write: if isAdmin() && isValidPreferences(request.resource.data);
    }

    // Auditoría: accesos e inicios de sesión, aprobar/rechazar/revocar,
    // compartir/sacar del Calendar. NO es sobre el contenido de los
    // posteos. Solo el admin puede LEER el registro (es información
    // sobre personas, no algo para mostrarle a cualquier aprobado). Pero
    // cualquiera logueado puede CREAR una entrada, siempre y cuando sea
    // sobre sí mismo como actor (actorEmail == su propio email) — así se
    // puede registrar el login o el pedido de acceso de alguien que
    // todavía no está aprobado, sin necesitar isApproved() acá.
    function isValidAuditEntry(d) {
      return d.keys().hasOnly(['type', 'actorEmail', 'actorName', 'targetEmail', 'detail', 'device', 'ip', 'createdAt']) &&
        d.type in ['login', 'access_requested', 'access_approved', 'access_rejected', 'access_revoked', 'calendar_shared', 'calendar_unshared'] &&
        isNonEmptyString(d.actorEmail, 200) &&
        isNonEmptyString(d.actorName, 120) &&
        isOptionalString(d.get('targetEmail', null), 200) &&
        isOptionalString(d.get('detail', null), 300) &&
        // Resumen corto de navegador/SO (ver deviceLabel en index.html) —
        // se saca del user-agent en el cliente, sin backend.
        isOptionalString(d.get('device', null), 60) &&
        // IP pública (ver fetchPublicIp en index.html, pedida a un
        // servicio externo ya que no hay backend propio); 45 alcanza para
        // IPv4 y para la representación más larga de IPv6.
        isOptionalString(d.get('ip', null), 45) &&
        d.actorEmail == request.auth.token.email &&
        d.createdAt == request.time;
    }
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      // Quien no es admin solo puede registrar SU login o SU pedido de
      // acceso, sin targetEmail: antes cualquier cuenta de Google (aun sin
      // aprobar) podía plantar entradas "access_approved" sobre cualquiera.
      // Los tipos sobre terceros (aprobar/rechazar/revocar/Calendar) los
      // escribe solo el admin desde su panel.
      allow create: if isAdmin() && isValidAuditEntry(request.resource.data);
      allow create: if signedIn() && isValidAuditEntry(request.resource.data) &&
        request.resource.data.type in ['login', 'access_requested'] &&
        request.resource.data.get('targetEmail', null) == null;
      allow update, delete: if false;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
